<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Pocket Agent for Windows: WPF host with a WebView2 interface, the floating voice bubble,
    Windows tools (UI Automation, input, screenshots, OCR), speech and the tray icon.
    The platform-neutral logic lives in PocketAgent.Core.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <AssemblyName>PocketAgent.Windows</AssemblyName>
    <RootNamespace>PocketAgent.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PocketAgent.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Pocket Agent</Product>
    <Description>Voice-first assistant and MCP bridge for your Windows PC</Description>
    <Copyright>MIT License</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416;WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PocketAgent.Core\PocketAgent.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The HTML interface ships inside the EXE and is unpacked to %LOCALAPPDATA% at start-up. -->
    <EmbeddedResource Include="Ui\*.*" LogicalName="ui/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\PocketAgent.ico" LogicalName="PocketAgent.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- For F5 in Visual Studio: copies the Rust engine next to the debug build once it exists
         (a release build of rust-core). build-windows.ps1 places it beside the published EXE itself. -->
    <None Include="..\..\rust-core\target\release\pocket_agent_core.dll" Condition="Exists('..\..\rust-core\target\release\pocket_agent_core.dll')"
          Link="pocket_agent_core.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Visible="false" />
  </ItemGroup>
</Project>
